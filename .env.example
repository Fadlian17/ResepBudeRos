# Server Configuration
PORT=4000

# CORS - Allowed origin (e.g., http://localhost:4000 or https://yourdomain.com)
ALLOWED_ORIGIN=http://localhost:4000

# Admin Authentication
# REQUIRED: Secret key for JWT token signing (min 32 characters recommended)
ADMIN_SECRET=your-secure-random-secret-here

# REQUIRED: Admin code for login verification
ADMIN_CODE=123456
